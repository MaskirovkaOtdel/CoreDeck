@model Final_Efstathiadis_Theodors.Controllers.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg cyber-card">
                <div class="card-header cyber-card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-key me-2"></i> Security Protocol</h4>
                    <span class="badge bg-warning text-dark">Password Rotation</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label text-light fw-bold"></label>
                            <input asp-for="CurrentPassword" class="form-control cyber-input" placeholder="••••••••" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label text-light fw-bold"></label>
                            <input asp-for="NewPassword" class="form-control cyber-input" placeholder="••••••••" />
                            <small class="text-muted">Must be at least 8 characters with upper, lower, and numeric symbols.</small>
                            <span asp-validation-for="NewPassword" class="text-danger small d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label text-light fw-bold"></label>
                            <input asp-for="ConfirmPassword" class="form-control cyber-input" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a href="@Url.Action("Profile", "Account")" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-cyber-primary">
                                <i class="fas fa-lock me-1"></i> Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

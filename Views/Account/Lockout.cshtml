@{
    ViewData["Title"] = "Account Locked";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-lg border-warning cyber-card text-center p-4">
            <div class="card-body">
                <div class="mb-4">
                    <span class="cyber-icon-badge text-warning">
                        <i class="fas fa-lock fa-4x text-warning"></i>
                    </span>
                </div>
                <h1 class="h2 text-warning fw-bold mb-3">SECURITY LOCKOUT</h1>
                <p class="text-muted lead mb-4">
                    This account has been temporarily locked out due to multiple failed authentication attempts. Please try again later or contact system administration.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-cyber-primary">
                        <i class="fas fa-home me-2"></i> Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

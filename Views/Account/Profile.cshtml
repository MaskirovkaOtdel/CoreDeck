@model ApplicationUser

@{
    ViewData["Title"] = "Operator Profile";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show cyber-alert mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-lg cyber-card">
                <div class="card-header cyber-card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-id-card me-2"></i> Operator Identity</h4>
                    <span class="badge bg-cyber-neon text-dark">Verified User</span>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4 g-3">
                        <div class="col-md-6">
                            <h6 class="text-cyan small text-uppercase fw-bold">First Name</h6>
                            <p class="h5 text-light">@Model.FirstName</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-cyan small text-uppercase fw-bold">Last Name</h6>
                            <p class="h5 text-light">@Model.LastName</p>
                        </div>
                    </div>

                    <div class="row mb-4 g-3">
                        <div class="col-md-6">
                            <h6 class="text-cyan small text-uppercase fw-bold">Email Protocol</h6>
                            <p class="h5 text-light font-monospace">@Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-cyan small text-uppercase fw-bold">Comms Line (Phone)</h6>
                            <p class="h5 text-light">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not configured" : Model.PhoneNumber)</p>
                        </div>
                    </div>

                    <hr class="border-secondary my-4" />

                    <h5 class="text-cyan mb-3"><i class="fas fa-map-marker-alt me-2"></i> Shipping Coordinates</h5>

                    <div class="row mb-3 g-3">
                        <div class="col-md-6">
                            <h6 class="text-muted small">Street Address</h6>
                            <p class="text-light">@(string.IsNullOrEmpty(Model.Address) ? "No address registered" : Model.Address)</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted small">City</h6>
                            <p class="text-light">@(string.IsNullOrEmpty(Model.City) ? "Not set" : Model.City)</p>
                        </div>
                    </div>

                    <div class="row mb-4 g-3">
                        <div class="col-md-6">
                            <h6 class="text-muted small">Postal Code</h6>
                            <p class="text-light">@(string.IsNullOrEmpty(Model.PostalCode) ? "Not set" : Model.PostalCode)</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted small">Country</h6>
                            <p class="text-light">@(string.IsNullOrEmpty(Model.Country) ? "Not set" : Model.Country)</p>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 pt-2">
                        <a href="@Url.Action("EditProfile", "Account")" class="btn btn-cyber-primary">
                            <i class="fas fa-edit me-1"></i> Edit Profile
                        </a>
                        <a href="@Url.Action("ChangePassword", "Account")" class="btn btn-outline-secondary">
                            <i class="fas fa-key me-1"></i> Change Password
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-lg cyber-card mb-4">
                <div class="card-header cyber-card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-shield-alt text-cyan me-2"></i> Account Status</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-success me-2"><i class="fas fa-check"></i> Active</span>
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge bg-danger">Root Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">Hardware Enthusiast</span>
                        }
                    </div>
                    <p class="text-muted small mb-0">
                        Commissioned on @Model.CreatedDate.ToString("MMMM dd, yyyy")
                    </p>
                </div>
            </div>

            <div class="card shadow-lg cyber-card">
                <div class="card-header cyber-card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-bolt text-warning me-2"></i> Quick Deck</h5>
                </div>
                <div class="card-body d-grid gap-2">
                    <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-cyber btn-sm text-start">
                        <i class="fas fa-box-open me-2 text-cyan"></i> Deployment Orders
                    </a>
                    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-cyber btn-sm text-start">
                        <i class="fas fa-shopping-cart me-2 text-cyan"></i> Active Requisition Cart
                    </a>
                    <a href="@Url.Action("Index", "Product")" class="btn btn-outline-cyber btn-sm text-start">
                        <i class="fas fa-microchip me-2 text-cyan"></i> Browse Hardware Arsenal
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <hr class="border-secondary my-2" />
                        <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-outline-warning btn-sm text-start">
                            <i class="fas fa-cogs me-2"></i> Admin Hardware Catalog
                        </a>
                        <a href="@Url.Action("Index", "AdminOrder")" class="btn btn-outline-warning btn-sm text-start">
                            <i class="fas fa-clipboard-list me-2"></i> Admin Orders Dispatch
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@model IEnumerable<Final_Efstathiadis_Theodors.Models.WishlistItem>

@{
    ViewData["Title"] = "Saved Wishlist";
    var wishlistItems = Model?.ToList() ?? new List<Final_Efstathiadis_Theodors.Models.WishlistItem>();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb cyber-breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Product")">Arsenal</a></li>
            <li class="breadcrumb-item active text-cyan" aria-current="page">Saved Wishlist</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show cyber-alert mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show cyber-alert mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-cyan fw-bold mb-1">
                <i class="fas fa-heart text-danger me-2"></i> Tracked Hardware Wishlist
            </h2>
            <p class="text-muted small mb-0">Hardware components saved to your operator watchlist for expedited requisition</p>
        </div>
        @if (wishlistItems.Any())
        {
            <span class="badge bg-secondary bg-opacity-50 text-cyan border border-secondary font-monospace px-3 py-2">
                @wishlistItems.Count @(wishlistItems.Count == 1 ? "Component" : "Components")
            </span>
        }
    </div>

    @if (!wishlistItems.Any())
    {
        <div class="card shadow-lg cyber-card text-center py-5">
            <div class="card-body">
                <i class="far fa-heart fa-4x text-muted mb-3"></i>
                <h4 class="text-light">Your wishlist is empty</h4>
                <p class="text-muted small mb-4">You have not bookmarked any graphics cards, processors, or peripherals to your operator watchlist.</p>
                <a href="@Url.Action("Index", "Product")" class="btn btn-cyber-primary">
                    <i class="fas fa-microchip me-2"></i> Explore Hardware Arsenal
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-lg cyber-card">
            <div class="card-header cyber-card-header bg-dark d-flex justify-content-between align-items-center">
                <span class="text-light fw-bold"><i class="fas fa-list me-2"></i> Saved Components</span>
                <a href="@Url.Action("Index", "Product")" class="btn btn-outline-cyber btn-sm">
                    <i class="fas fa-plus me-1"></i> Browse More
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover cyber-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Hardware Component</th>
                            <th>Unit Price</th>
                            <th>Status</th>
                            <th>Saved Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in wishlistItems)
                        {
                            var prod = item.Product;
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@prod?.ImageUrl" 
                                             alt="@prod?.Name" 
                                             class="rounded cyber-thumb"
                                             style="width: 60px; height: 60px; object-fit: cover; background: #0a0e17;" />
                                        <div>
                                            <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" 
                                               class="text-decoration-none text-light fw-bold">
                                                @prod?.Name
                                            </a>
                                            <div class="d-flex gap-2 align-items-center mt-1">
                                                <span class="badge bg-secondary bg-opacity-50 text-light small">@prod?.Category?.Name</span>
                                                <span class="text-muted small font-monospace">CD-@item.ProductId.ToString("D6")</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td class="text-cyan font-monospace fw-bold">
                                    €@(prod?.Price.ToString("F2") ?? "0.00")
                                </td>

                                <td>
                                    @if (prod != null && prod.Stock > 5)
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success">
                                            <i class="fas fa-check-circle me-1"></i> In Stock (@prod.Stock)
                                        </span>
                                    }
                                    else if (prod != null && prod.Stock > 0)
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning">
                                            <i class="fas fa-exclamation-triangle me-1"></i> Low Stock (@prod.Stock)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger">
                                            <i class="fas fa-times-circle me-1"></i> Allocation Depleted
                                        </span>
                                    }
                                </td>

                                <td class="text-muted font-monospace small">
                                    @item.AddedDate.ToString("yyyy-MM-dd")
                                </td>

                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" 
                                           class="btn btn-outline-secondary btn-sm" 
                                           title="Inspect Specs">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        @if (prod != null && prod.Stock > 0)
                                        {
                                            <form asp-controller="Wishlist" asp-action="MoveToCart" method="post" class="d-inline">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-cyber-primary btn-sm" title="Transfer to Cart">
                                                    <i class="fas fa-cart-arrow-down me-1"></i> Requisition
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled title="Depleted">
                                                <i class="fas fa-ban me-1"></i> Depleted
                                            </button>
                                        }

                                        <form asp-controller="Wishlist" asp-action="Remove" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove from Wishlist">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

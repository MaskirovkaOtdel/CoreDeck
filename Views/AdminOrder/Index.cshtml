@model List<Order>

@{
    ViewData["Title"] = "Admin - Orders Dispatch Control";
    var currentStatus = ViewData["CurrentStatus"] as OrderStatus?;
    var searchTerm = ViewData["SearchTerm"] as string ?? "";
}

<div class="container-fluid py-3">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show cyber-alert mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="text-cyan fw-bold mb-1">
                <i class="fas fa-clipboard-list me-2"></i> Orders Dispatch Management
            </h2>
            <p class="text-muted small mb-0">Monitor customer requisitions, process fulfillment, and update tracking state</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-outline-cyber">
                <i class="fas fa-microchip me-1"></i> Inventory Catalog
            </a>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card shadow-lg cyber-card mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text cyber-addon"><i class="fas fa-search text-cyan"></i></span>
                        <input type="text" name="search" class="form-control cyber-input" 
                               placeholder="Search by Order # or Customer Email / Name..." value="@searchTerm" />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <label class="input-group-text cyber-addon text-muted">Status:</label>
                        <select name="status" class="form-select cyber-input" onchange="this.form.submit()">
                            <option value="">All Statuses</option>
                            @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                            {
                                <option value="@s" selected="@(currentStatus == s)">@s</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-cyber-primary btn-sm flex-grow-1">
                        <i class="fas fa-filter me-1"></i> Filter
                    </button>
                    <a href="@Url.Action("Index", "AdminOrder")" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                        <i class="fas fa-undo"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="card shadow-lg cyber-card">
        <div class="card-header cyber-card-header bg-dark d-flex justify-content-between align-items-center">
            <span class="text-light fw-bold"><i class="fas fa-boxes me-2"></i> Customer Orders (@Model.Count items)</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="card-body text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <h5 class="text-light">No orders match filter criteria</h5>
                <p class="text-muted small">Orders placed by customers will automatically register here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover cyber-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Date (UTC)</th>
                            <th>Payload</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="font-monospace text-cyan fw-bold">
                                    #CD-@order.Id.ToString("D6")
                                </td>
                                <td>
                                    <div class="text-light fw-bold">@(order.User?.GetFullName() ?? "Guest / User")</div>
                                    <small class="text-muted font-monospace">@(order.User?.Email ?? order.UserId)</small>
                                </td>
                                <td class="small text-muted font-monospace">
                                    @order.OrderDate.ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td class="small text-light">
                                    @order.OrderItems.Count item(s) &bull; @order.OrderItems.Sum(oi => oi.Quantity) units
                                </td>
                                <td class="font-monospace text-cyan fw-bold">
                                    €@order.TotalPrice.ToString("F2")
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadge(order.Status)">@order.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Details", "AdminOrder", new { id = order.Id })" 
                                           class="btn btn-outline-primary" title="Manage Order">
                                            <i class="fas fa-cog me-1"></i> Manage
                                        </a>
                                        <a href="@Url.Action("Invoice", "Order", new { id = order.Id })" 
                                           target="_blank"
                                           class="btn btn-outline-secondary" title="View Tax Invoice">
                                            <i class="fas fa-file-invoice"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@functions {
    private string GetStatusBadge(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "bg-warning text-dark",
            OrderStatus.Processing => "bg-info text-dark",
            OrderStatus.Shipped => "bg-primary text-white",
            OrderStatus.Delivered => "bg-success text-white",
            OrderStatus.Cancelled => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }
}

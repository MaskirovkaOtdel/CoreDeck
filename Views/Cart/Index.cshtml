@model Cart

@{
    ViewData["Title"] = "Hardware Requisition Cart";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show cyber-alert mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show cyber-alert mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-4">
        <h2 class="text-cyan fw-bold"><i class="fas fa-shopping-cart me-2"></i> Requisition Cart</h2>
        <p class="text-muted small">Review your enthusiast hardware loadout before finalizing dispatch</p>
    </div>

    @if (Model?.CartItems == null || Model.CartItems.Count == 0)
    {
        <div class="card shadow-lg cyber-card text-center py-5">
            <div class="card-body">
                <i class="fas fa-cart-arrow-down fa-4x text-muted mb-3"></i>
                <h4 class="text-light">Your loadout is empty</h4>
                <p class="text-muted small mb-4">You have not queued any gaming PCs, GPUs, or components for dispatch yet.</p>
                <a href="@Url.Action("Index", "Product")" class="btn btn-cyber-primary">
                    <i class="fas fa-microchip me-2"></i> Access Hardware Arsenal
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="card shadow-lg cyber-card">
                    <div class="card-header cyber-card-header bg-dark d-flex justify-content-between align-items-center">
                        <span class="text-light fw-bold"><i class="fas fa-layer-group me-2"></i> Queued Hardware (@Model.CartItems.Count items)</span>
                        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-cyber btn-sm">
                            <i class="fas fa-plus me-1"></i> Add More Items
                        </a>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover cyber-table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Hardware Component</th>
                                    <th>Unit Price</th>
                                    <th>Units</th>
                                    <th>Subtotal</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@item.Product?.ImageUrl" 
                                                     alt="@item.Product?.Name" 
                                                     class="rounded cyber-thumb"
                                                     style="width: 60px; height: 60px; object-fit: cover;" />
                                                <div>
                                                    <a href="@Url.Action("Details", "Product", new { id = item.ProductId })" 
                                                       class="text-decoration-none text-light fw-bold">
                                                        @item.Product?.Name
                                                    </a>
                                                    <div class="text-muted small font-monospace">SKU: CD-@item.ProductId.ToString("D6")</div>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="text-cyan font-monospace">
                                            €@item.UnitPrice.ToString("F2")
                                        </td>

                                        <td style="min-width: 140px;">
                                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-1">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <input type="number" 
                                                       name="quantity" 
                                                       class="form-control form-control-sm cyber-input text-center font-monospace" 
                                                       value="@item.Quantity" 
                                                       min="1" 
                                                       max="@(item.Product?.Stock ?? 99)" 
                                                       style="width: 70px;" 
                                                       onchange="this.form.submit()" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Refresh count">
                                                    <i class="fas fa-sync-alt"></i>
                                                </button>
                                            </form>
                                        </td>

                                        <td class="text-cyan fw-bold font-monospace">
                                            €@item.GetTotalPrice().ToString("F2")
                                        </td>

                                        <td class="text-end">
                                            <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" class="d-inline">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Remove Component">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="card shadow-lg cyber-card sticky-top" style="top: 85px;">
                    <div class="card-header cyber-card-header bg-dark">
                        <h5 class="mb-0 text-cyan"><i class="fas fa-receipt me-2"></i> Requisition Summary</h5>
                    </div>
                    <div class="card-body p-4">
                        @{
                            decimal subtotal = Model.GetTotalPrice();
                            decimal shipping = subtotal >= 100 ? 0 : 9.99m;
                            decimal total = subtotal + shipping;
                        }

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Loadout Subtotal:</span>
                            <span class="text-light font-monospace">€@subtotal.ToString("F2")</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Cyber Express Dispatch:</span>
                            <span class="font-monospace">
                                @if (shipping == 0)
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success">FREE OVER €100</span>
                                }
                                else
                                {
                                    <span class="text-light">€@shipping.ToString("F2")</span>
                                }
                            </span>
                        </div>

                        <div class="cyber-divider mb-3"></div>

                        <div class="d-flex justify-content-between align-items-baseline mb-4">
                            <span class="h6 text-light fw-bold mb-0">Total Requisition:</span>
                            <span class="h4 text-cyan fw-bold font-monospace mb-0">€@total.ToString("F2")</span>
                        </div>

                        <a href="@Url.Action("Checkout", "Cart")" class="btn btn-cyber-primary btn-lg w-100 py-3 fw-bold mb-2">
                            <i class="fas fa-cash-register me-2"></i> Proceed to Checkout
                        </a>

                        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-arrow-left me-1"></i> Continue Shopping
                        </a>

                        <div class="text-center mt-3 pt-3 border-top border-secondary">
                            <small class="text-muted">
                                <i class="fas fa-shield-alt text-cyan me-1"></i> 256-bit SSL Hardware Encryption
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

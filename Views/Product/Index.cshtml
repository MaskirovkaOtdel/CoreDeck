@model List<Product>

@{
    ViewData["Title"] = "Products";
    var categoryId = (int?)ViewData["CategoryId"] ?? 0;
    var categories = (List<Category>?)ViewData["Categories"] ?? new();
    var currentPage = (int?)ViewData["CurrentPage"] ?? 1;
    var totalPages = (int?)ViewData["TotalPages"] ?? 1;
    var searchTerm = (string?)ViewData["SearchTerm"] ?? "";
}

<div class="row mb-4">
    <div class="col-lg-3">
        <!-- Sidebar with Categories -->
        <div class="card sticky-top" style="top: 80px;">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-filter"></i> Categories</h5>
            </div>
            <div class="list-group list-group-flush">
                <a href="@Url.Action("Index", "Product")" 
                   class="list-group-item list-group-item-action @(categoryId == 0 ? "active" : "")">
                    <i class="fas fa-cube"></i> All Products
                </a>
                @foreach (var category in categories)
                {
                    <a href="@Url.Action("Index", "Product", new { categoryId = category.Id })" 
                       class="list-group-item list-group-item-action @(categoryId == category.Id ? "active" : "")">
                        <i class="@(string.IsNullOrEmpty(category.IconUrl) ? "fas fa-tag" : "")"></i> @category.Name
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <!-- Header Section -->
        <div class="mb-4">
            <h2 class="mb-3">
                @if (string.IsNullOrEmpty(searchTerm))
                {
                    <span>Shop Our Collection</span>
                }
                else
                {
                    <span>Search Results: "@searchTerm"</span>
                }
            </h2>

            <div class="alert alert-info" role="alert">
                <i class="fas fa-info-circle"></i> 
                Showing @Model.Count products
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <text> for "@searchTerm"</text>
                }
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-warning text-center" role="alert">
                <i class="fas fa-inbox"></i>
                <p class="mb-0">No products found. Try adjusting your search or browse our categories.</p>
            </div>
        }
        else
        {
            <!-- Products Grid -->
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                @foreach (var product in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm hover-shadow transition-all">
                            <!-- Product Image -->
                            <div class="position-relative overflow-hidden" style="height: 200px;">
                                <img src="@product.ImageUrl" 
                                     class="card-img-top img-fluid" 
                                     alt="@product.Name"
                                     style="height: 100%; object-fit: cover;" />
                                @if (product.Stock <= 5 && product.Stock > 0)
                                {
                                    <span class="badge bg-warning position-absolute top-0 end-0 m-2">Low Stock</span>
                                }
                                @if (product.Stock == 0)
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">Out of Stock</span>
                                }
                            </div>

                            <!-- Product Info -->
                            <div class="card-body d-flex flex-column">
                                <a href="@Url.Action("Details", "Product", new { id = product.Id })" 
                                   class="text-decoration-none text-dark">
                                    <h5 class="card-title">@product.Name</h5>
                                </a>

                                <p class="card-text text-muted small flex-grow-1">
                                    @product.Description
                                </p>

                                <div class="mb-3">
                                    <span class="badge bg-secondary">@product.Category?.Name</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="text-primary mb-0">
                                        €@product.Price.ToString("F2")
                                    </h4>
                                    <small class="text-muted">Stock: @product.Stock</small>
                                </div>
                            </div>

                            <!-- Card Footer with Actions -->
                            <div class="card-footer bg-light border-top-0 d-grid gap-2">
                                <a href="@Url.Action("Details", "Product", new { id = product.Id })" 
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye"></i> View Details
                                </a>
                                @if (product.Stock > 0)
                                {
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-primary btn-sm w-100">
                                            <i class="fas fa-shopping-cart"></i> Add to Cart
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm w-100" disabled>
                                        <i class="fas fa-times"></i> Out of Stock
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <nav aria-label="Page navigation" class="mb-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" 
                                   href="@Url.Action("Index", "Product", new { categoryId = categoryId, page = i, search = searchTerm })">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</div>

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease;
    }

    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15) !important;
        transform: translateY(-2px);
    }

    .transition-all {
        transition: all 0.3s ease;
    }
</style>

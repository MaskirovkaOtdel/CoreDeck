@model List<Product>

@{
    ViewData["Title"] = "Hardware Arsenal";
    var categoryId = (int?)ViewData["CategoryId"] ?? 0;
    var categories = (List<Category>?)ViewData["Categories"] ?? new();
    var currentPage = (int?)ViewData["CurrentPage"] ?? 1;
    var totalPages = (int?)ViewData["TotalPages"] ?? 1;
    var totalCount = (int?)ViewData["TotalCount"] ?? 0;
    var searchTerm = (string?)ViewData["SearchTerm"] ?? "";
    var minPrice = (decimal?)ViewData["MinPrice"];
    var maxPrice = (decimal?)ViewData["MaxPrice"];
    var inStockOnly = (bool?)ViewData["InStockOnly"] ?? false;
    var sortOrder = (string?)ViewData["SortOrder"] ?? "newest";

    string CurrentCategoryName()
    {
        if (categoryId == 0) return "All Hardware Categories";
        var cat = categories.FirstOrDefault(c => c.Id == categoryId);
        return cat?.Name ?? "Selected Category";
    }
}

<div class="container-fluid py-3">
    <!-- Header banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom border-secondary">
        <div>
            <h1 class="h2 text-cyan fw-bold mb-1">
                <i class="fas fa-microchip me-2"></i> @CurrentCategoryName()
            </h1>
            <p class="text-muted small mb-0">
                Enthusiast gaming rigs, Ada Lovelace / RDNA GPUs, high-speed NVMe silicon, and esports peripherals
            </p>
        </div>
        <div class="text-md-end">
            <span class="badge bg-dark border border-cyan text-cyan py-2 px-3 fs-6">
                <i class="fas fa-layer-group me-1"></i> @totalCount Hardware Units Online
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Filter Sidebar -->
        <div class="col-lg-3">
            <form id="filterForm" method="get" asp-action="Index">
                <!-- Preserve Category and Sort Order -->
                <input type="hidden" name="categoryId" value="@categoryId" />
                <input type="hidden" name="sortOrder" value="@sortOrder" />

                <!-- Search Input -->
                <div class="card shadow cyber-card mb-4">
                    <div class="card-header cyber-card-header bg-dark">
                        <h6 class="mb-0 text-cyan"><i class="fas fa-search me-2"></i> Search Arsenal</h6>
                    </div>
                    <div class="card-body">
                        <div class="input-group">
                            <input type="text" name="search" class="form-control cyber-input" 
                                   placeholder="RTX, OLED, DDR5..." value="@searchTerm" />
                            <button class="btn btn-cyber-primary" type="submit">
                                <i class="fas fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Categories -->
                <div class="card shadow cyber-card mb-4">
                    <div class="card-header cyber-card-header bg-dark d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 text-cyan"><i class="fas fa-boxes me-2"></i> Categories</h6>
                    </div>
                    <div class="list-group list-group-flush cyber-list-group">
                        <a href="@Url.Action("Index", "Product", new { categoryId = 0, search = searchTerm, minPrice, maxPrice, inStockOnly, sortOrder })" 
                           class="list-group-item list-group-item-action cyber-list-item @(categoryId == 0 ? "active" : "")">
                            <i class="fas fa-cube me-2 text-cyan"></i> All Categories
                        </a>
                        @foreach (var category in categories)
                        {
                            <a href="@Url.Action("Index", "Product", new { categoryId = category.Id, search = searchTerm, minPrice, maxPrice, inStockOnly, sortOrder })" 
                               class="list-group-item list-group-item-action cyber-list-item @(categoryId == category.Id ? "active" : "")">
                                <i class="@(string.IsNullOrEmpty(category.IconUrl) ? "fas fa-tag" : category.IconUrl) me-2 text-cyan"></i>
                                @category.Name
                            </a>
                        }
                    </div>
                </div>

                <!-- Price Range Filter -->
                <div class="card shadow cyber-card mb-4">
                    <div class="card-header cyber-card-header bg-dark">
                        <h6 class="mb-0 text-cyan"><i class="fas fa-euro-sign me-2"></i> Price Filter (€)</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label text-muted small">Min Price</label>
                                <input type="number" name="minPrice" class="form-control cyber-input font-monospace" 
                                       placeholder="0" value="@(minPrice?.ToString() ?? "")" min="0" step="10" />
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted small">Max Price</label>
                                <input type="number" name="maxPrice" class="form-control cyber-input font-monospace" 
                                       placeholder="5000" value="@(maxPrice?.ToString() ?? "")" min="0" step="10" />
                            </div>
                        </div>

                        <!-- In-Stock Filter -->
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="inStockOnly" value="true" 
                                   id="inStockCheck" @(inStockOnly ? "checked" : "") />
                            <label class="form-check-label text-light small" for="inStockCheck">
                                In-Stock Hardware Only
                            </label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-cyber-primary btn-sm">
                                <i class="fas fa-filter me-1"></i> Apply Filters
                            </button>
                            <a href="@Url.Action("Index", "Product")" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-undo me-1"></i> Reset All
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Products Area -->
        <div class="col-lg-9">
            <!-- Sort & Active Filters Toolbar -->
            <div class="card shadow cyber-card mb-4">
                <div class="card-body p-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="text-muted small">Showing @Model.Count of @totalCount products</span>
                        @if (!string.IsNullOrEmpty(searchTerm))
                        {
                            <span class="badge bg-dark border border-cyan text-cyan">
                                Query: "@searchTerm"
                                <a href="@Url.Action("Index", "Product", new { categoryId, minPrice, maxPrice, inStockOnly, sortOrder })" class="text-cyan ms-1">&times;</a>
                            </span>
                        }
                        @if (minPrice.HasValue || maxPrice.HasValue)
                        {
                            <span class="badge bg-dark border border-secondary text-light">
                                Price: €@(minPrice ?? 0) - €@(maxPrice.HasValue ? maxPrice.Value.ToString() : "∞")
                            </span>
                        }
                        @if (inStockOnly)
                        {
                            <span class="badge bg-success bg-opacity-25 text-success border border-success">
                                <i class="fas fa-check"></i> In Stock
                            </span>
                        }
                    </div>

                    <!-- Sort Select -->
                    <div class="d-flex align-items-center gap-2">
                        <label class="text-muted small text-nowrap mb-0"><i class="fas fa-sort me-1"></i> Sort:</label>
                        <select class="form-select form-select-sm cyber-input" style="min-width: 170px;" 
                                onchange="location = this.value;">
                            <option value="@Url.Action("Index", "Product", new { categoryId, search = searchTerm, minPrice, maxPrice, inStockOnly, sortOrder = "newest" })" 
                                    selected="@(sortOrder == "newest")">Newest Arrivals</option>
                            <option value="@Url.Action("Index", "Product", new { categoryId, search = searchTerm, minPrice, maxPrice, inStockOnly, sortOrder = "price_asc" })" 
                                    selected="@(sortOrder == "price_asc")">Price: Low to High</option>
                            <option value="@Url.Action("Index", "Product", new { categoryId, search = searchTerm, minPrice, maxPrice, inStockOnly, sortOrder = "price_desc" })" 
                                    selected="@(sortOrder == "price_desc")">Price: High to Low</option>
                            <option value="@Url.Action("Index", "Product", new { categoryId, search = searchTerm, minPrice, maxPrice, inStockOnly, sortOrder = "name" })" 
                                    selected="@(sortOrder == "name")">Alphabetical (A-Z)</option>
                        </select>
                    </div>
                </div>
            </div>

            @if (Model.Count == 0)
            {
                <div class="card shadow cyber-card text-center py-5">
                    <div class="card-body">
                        <i class="fas fa-search-minus fa-3x text-muted mb-3"></i>
                        <h4 class="text-light">No hardware matching your criteria</h4>
                        <p class="text-muted small mb-4">Try clearing some filters or exploring other categories in the arsenal.</p>
                        <a href="@Url.Action("Index", "Product")" class="btn btn-cyber-primary">
                            <i class="fas fa-redo me-1"></i> View All Products
                        </a>
                    </div>
                </div>
            }
            else
            {
                <!-- Product Grid -->
                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-4">
                    @foreach (var product in Model)
                    {
                        <div class="col">
                            <partial name="_ProductCard" model="product" />
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav aria-label="Catalog navigation" class="mt-4">
                        <ul class="pagination justify-content-center cyber-pagination">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" 
                                   href="@Url.Action("Index", "Product", new { categoryId, page = currentPage - 1, search = searchTerm, minPrice, maxPrice, inStockOnly, sortOrder })">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" 
                                       href="@Url.Action("Index", "Product", new { categoryId, page = i, search = searchTerm, minPrice, maxPrice, inStockOnly, sortOrder })">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" 
                                   href="@Url.Action("Index", "Product", new { categoryId, page = currentPage + 1, search = searchTerm, minPrice, maxPrice, inStockOnly, sortOrder })">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

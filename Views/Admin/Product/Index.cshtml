@model List<Product>

@{
    ViewData["Title"] = "Product Management";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <h2><i class="fas fa-cog"></i> Product Management</h2>
    <a href="@Url.Action("Create", "AdminProduct")" class="btn btn-success">
        <i class="fas fa-plus"></i> Add New Product
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        <i class="fas fa-inbox"></i> No products found. 
        <a href="@Url.Action("Create", "AdminProduct")">Create the first product</a>
    </div>
}
else
{
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <!-- Image -->
                            <td>
                                <img src="@product.ImageUrl" 
                                     alt="@product.Name" 
                                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                            </td>

                            <!-- Name -->
                            <td>
                                <strong>@product.Name</strong><br />
                                <small class="text-muted">@(product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)</small>
                            </td>

                            <!-- Category -->
                            <td>
                                <span class="badge bg-secondary">@product.Category?.Name</span>
                            </td>

                            <!-- Price -->
                            <td>
                                <strong class="text-primary">€@product.Price.ToString("F2")</strong>
                            </td>

                            <!-- Stock -->
                            <td>
                                @if (product.Stock > 10)
                                {
                                    <span class="badge bg-success">@product.Stock</span>
                                }
                                else if (product.Stock > 0)
                                {
                                    <span class="badge bg-warning">@product.Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out</span>
                                }
                            </td>

                            <!-- Created Date -->
                            <td>
                                <small>@product.CreatedDate.ToString("MMM dd, yyyy")</small>
                            </td>

                            <!-- Actions -->
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a href="@Url.Action("Edit", "AdminProduct", new { id = product.Id })" 
                                       class="btn btn-outline-primary" title="Edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a href="@Url.Action("Delete", "AdminProduct", new { id = product.Id })" 
                                       class="btn btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-light">
            <small class="text-muted">Total: @Model.Count products</small>
        </div>
    </div>
}

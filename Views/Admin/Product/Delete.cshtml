@model Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="alert alert-danger" role="alert">
    <h4 class="alert-heading"><i class="fas fa-exclamation-triangle"></i> Warning</h4>
    <p>You are about to permanently delete this product. This action cannot be undone.</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Confirm Product Deletion</h5>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-3">
                        <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" />
                    </div>
                    <div class="col-md-9">
                        <h5>@Model.Name</h5>
                        <p class="text-muted">@Model.Description</p>

                        <table class="table table-sm">
                            <tr>
                                <th>Category:</th>
                                <td>@Model.Category?.Name</td>
                            </tr>
                            <tr>
                                <th>Price:</th>
                                <td>€@Model.Price.ToString("F2")</td>
                            </tr>
                            <tr>
                                <th>Stock:</th>
                                <td>@Model.Stock units</td>
                            </tr>
                            <tr>
                                <th>Product ID:</th>
                                <td>@Model.Id</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> 
                    <strong>Note:</strong> All associated order records will be preserved, but this product will no longer be available for purchase.
                </div>

                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you absolutely sure you want to delete this product?')">
                            <i class="fas fa-trash"></i> Yes, Delete This Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

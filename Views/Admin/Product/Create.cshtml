@model Product

@{
    ViewData["Title"] = "Add New Product";
    var categories = (List<Category>?)ViewData["Categories"] ?? new();
}

<div class="mb-4">
    <h2><i class="fas fa-plus-circle"></i> Add New Product</h2>
    <p class="text-muted">Create a new product in the catalog</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Product Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Product Name *</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter product description"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <!-- Price -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label">Price (€) *</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <!-- Stock -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Stock" class="form-label">Stock Quantity *</label>
                            <input asp-for="Stock" type="number" class="form-control" placeholder="0" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label">Category *</label>
                        <select asp-for="CategoryId" asp-items="@new SelectList(categories, nameof(Category.Id), nameof(Category.Name))" class="form-select">
                            <option value="">-- Select a Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-4">
                        <label asp-for="ImageUrl" class="form-label">Image URL</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                        <small class="text-muted">Provide a direct link to the product image</small>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <!-- Preview Image -->
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-4">
                            <label class="form-label">Image Preview</label>
                            <div class="card">
                                <img src="@Model.ImageUrl" class="card-img" alt="@Model.Name" style="max-height: 300px; object-fit: cover;" />
                            </div>
                        </div>
                    }

                    <!-- Buttons -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Create Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Info Sidebar -->
    <div class="col-lg-4">
        <div class="card shadow mb-4 bg-light">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Tips</h5>
            </div>
            <div class="card-body">
                <h6 class="mb-2">Product Information</h6>
                <ul class="small">
                    <li>Use clear, descriptive product names</li>
                    <li>Include key specs in the description</li>
                    <li>High-quality images improve sales</li>
                    <li>Accurate pricing is essential</li>
                    <li>Keep stock levels updated</li>
                </ul>
            </div>
        </div>

        <div class="card shadow bg-warning bg-opacity-10">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Image Guidelines</h5>
            </div>
            <div class="card-body">
                <small class="text-muted">
                    <i class="fas fa-check text-success"></i> Use high-quality images (500x500px minimum)<br>
                    <i class="fas fa-check text-success"></i> Show product from multiple angles<br>
                    <i class="fas fa-check text-success"></i> Use consistent backgrounds<br>
                    <i class="fas fa-check text-success"></i> Include product in use if possible
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

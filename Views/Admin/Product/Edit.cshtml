@model Product

@{
    ViewData["Title"] = "Edit Product";
    var categories = (List<Category>?)ViewData["Categories"] ?? new();
}

<div class="mb-4">
    <h2><i class="fas fa-edit"></i> Edit Product</h2>
    <p class="text-muted">Update product details</p>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedDate" />

                    <!-- Product Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Product Name *</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <!-- Price -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label">Price (€) *</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <!-- Stock -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Stock" class="form-label">Stock Quantity *</label>
                            <input asp-for="Stock" type="number" class="form-control" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label">Category *</label>
                        <select asp-for="CategoryId" asp-items="@new SelectList(categories, nameof(Category.Id), nameof(Category.Name))" class="form-select">
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-4">
                        <label asp-for="ImageUrl" class="form-label">Image URL</label>
                        <input asp-for="ImageUrl" class="form-control" />
                        <small class="text-muted">Provide a direct link to the product image</small>
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <!-- Preview Image -->
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-4">
                            <label class="form-label">Current Image</label>
                            <div class="card">
                                <img src="@Model.ImageUrl" class="card-img" alt="@Model.Name" style="max-height: 300px; object-fit: cover;" />
                            </div>
                        </div>
                    }

                    <!-- Last Updated -->
                    <div class="alert alert-light mb-3">
                        <small class="text-muted">
                            Created: @Model.CreatedDate.ToString("MMMM dd, yyyy HH:mm")<br />
                            @if (Model.UpdatedDate.HasValue)
                            {
                                <text>Last updated: @Model.UpdatedDate.Value.ToString("MMMM dd, yyyy HH:mm")</text>
                            }
                        </small>
                    </div>

                    <!-- Buttons -->
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Info Sidebar -->
    <div class="col-lg-4">
        <div class="card shadow mb-4 bg-light">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Product Info</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Product ID:</dt>
                    <dd class="col-sm-7">@Model.Id</dd>

                    <dt class="col-sm-5">Current Stock:</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-primary">@Model.Stock</span>
                    </dd>

                    <dt class="col-sm-5">Category:</dt>
                    <dd class="col-sm-7">@Model.Category?.Name</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow">
            <div class="card-header bg-danger">
                <h5 class="mb-0 text-white">Danger Zone</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Delete this product permanently</p>
                <a href="@Url.Action("Delete", "AdminProduct", new { id = Model.Id })" class="btn btn-outline-danger btn-sm w-100">
                    <i class="fas fa-trash"></i> Delete Product
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

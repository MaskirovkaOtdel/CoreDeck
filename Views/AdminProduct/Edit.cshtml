@model Product

@{
    ViewData["Title"] = "Edit Product: " + Model.Name;
    var categories = (List<Category>?)ViewData["Categories"] ?? new();
}

<div class="container py-3">
    <div class="mb-4">
        <h2 class="text-cyan fw-bold"><i class="fas fa-edit me-2"></i> Modify Hardware Parameters</h2>
        <p class="text-muted small">Update pricing, inventory levels, and technical specs for SKU: CD-@Model.Id.ToString("D6")</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-lg cyber-card">
                <div class="card-header cyber-card-header bg-dark">
                    <h5 class="mb-0 text-light"><i class="fas fa-sliders-h me-2"></i> Hardware Specifications</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedDate" />

                        <!-- Product Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label text-light fw-bold">Product Name *</label>
                            <input asp-for="Name" class="form-control cyber-input" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label text-light fw-bold">Technical Description *</label>
                            <textarea asp-for="Description" class="form-control cyber-input" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <!-- Price -->
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label text-light fw-bold">Retail Price (€) *</label>
                                <div class="input-group">
                                    <span class="input-group-text cyber-addon">€</span>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control cyber-input" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <!-- Stock -->
                            <div class="col-md-6">
                                <label asp-for="Stock" class="form-label text-light fw-bold">Warehouse Stock Units *</label>
                                <input asp-for="Stock" type="number" class="form-control cyber-input" />
                                <span asp-validation-for="Stock" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label text-light fw-bold">Hardware Classification *</label>
                            <select asp-for="CategoryId" asp-items="@new SelectList(categories, nameof(Category.Id), nameof(Category.Name))" class="form-select cyber-input">
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Image URL -->
                        <div class="mb-4">
                            <label asp-for="ImageUrl" class="form-label text-light fw-bold">Hardware Photograph Link (URL) *</label>
                            <input asp-for="ImageUrl" class="form-control cyber-input" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-4">
                                <label class="form-label text-muted small">Current Media Preview</label>
                                <div class="card bg-dark border-secondary p-2 text-center">
                                    <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" style="max-height: 250px; object-fit: contain;" />
                                </div>
                            </div>
                        }

                        <div class="form-check mb-4">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label text-light">
                                Visible in Public Catalog (Active Status)
                            </label>
                        </div>

                        <div class="alert alert-dark border-secondary mb-4">
                            <small class="text-muted font-monospace">
                                Initialized: @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss") UTC<br />
                                @if (Model.UpdatedDate.HasValue)
                                {
                                    <text>Last Revision: @Model.UpdatedDate.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</text>
                                }
                            </small>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-cyber-primary">
                                <i class="fas fa-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-lg cyber-card mb-4">
                <div class="card-header cyber-card-header bg-dark">
                    <h5 class="mb-0 text-cyan"><i class="fas fa-info-circle me-2"></i> Inventory Status</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted small">Product ID:</dt>
                        <dd class="col-sm-7 text-light font-monospace">#@Model.Id</dd>

                        <dt class="col-sm-5 text-muted small">SKU:</dt>
                        <dd class="col-sm-7 text-cyan font-monospace">CD-@Model.Id.ToString("D6")</dd>

                        <dt class="col-sm-5 text-muted small">Status:</dt>
                        <dd class="col-sm-7">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Deactivated</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-lg cyber-card border-danger">
                <div class="card-header cyber-card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i> Danger Zone</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Deactivate this item from the public catalog while preserving historical order logs.</p>
                    <a href="@Url.Action("Delete", "AdminProduct", new { id = Model.Id })" class="btn btn-outline-danger btn-sm w-100">
                        <i class="fas fa-trash me-1"></i> Deactivate Hardware Item
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

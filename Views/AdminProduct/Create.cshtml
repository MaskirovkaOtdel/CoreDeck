@model Product

@{
    ViewData["Title"] = "Add Hardware Product";
    var categories = (List<Category>?)ViewData["Categories"] ?? new();
}

<div class="container py-3">
    <div class="mb-4">
        <h2 class="text-cyan fw-bold"><i class="fas fa-plus-circle me-2"></i> Commission New Hardware</h2>
        <p class="text-muted small">Register high-performance components or battlestations into the CoreDeck inventory</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-lg cyber-card">
                <div class="card-header cyber-card-header bg-dark">
                    <h5 class="mb-0 text-light"><i class="fas fa-sliders-h me-2"></i> Hardware Specifications</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Product Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label text-light fw-bold">Product Name *</label>
                            <input asp-for="Name" class="form-control cyber-input" placeholder="e.g. NVIDIA GeForce RTX 5090 Cyber OC 32GB" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label text-light fw-bold">Technical Description & Architecture *</label>
                            <textarea asp-for="Description" class="form-control cyber-input" rows="4" placeholder="Detail memory bandwidth, boost clocks, cooling design, interface requirements..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <!-- Price -->
                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label text-light fw-bold">Retail Price (€) *</label>
                                <div class="input-group">
                                    <span class="input-group-text cyber-addon">€</span>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control cyber-input" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <!-- Stock -->
                            <div class="col-md-6">
                                <label asp-for="Stock" class="form-label text-light fw-bold">Warehouse Stock Units *</label>
                                <input asp-for="Stock" type="number" class="form-control cyber-input" placeholder="0" />
                                <span asp-validation-for="Stock" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label text-light fw-bold">Hardware Classification *</label>
                            <select asp-for="CategoryId" asp-items="@new SelectList(categories, nameof(Category.Id), nameof(Category.Name))" class="form-select cyber-input">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Image URL -->
                        <div class="mb-4">
                            <label asp-for="ImageUrl" class="form-label text-light fw-bold">Hardware Photograph Link (URL) *</label>
                            <input asp-for="ImageUrl" class="form-control cyber-input" placeholder="https://images.unsplash.com/..." />
                            <small class="text-muted">High-resolution direct image URL for product display</small>
                            <span asp-validation-for="ImageUrl" class="text-danger small d-block"></span>
                        </div>

                        <!-- Safe preview image checking null -->
                        @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                        {
                            <div class="mb-4">
                                <label class="form-label text-muted small">Image Preview</label>
                                <div class="card bg-dark border-secondary p-2 text-center">
                                    <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" style="max-height: 250px; object-fit: contain;" />
                                </div>
                            </div>
                        }

                        <div class="form-check mb-4">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" checked />
                            <label asp-for="IsActive" class="form-check-label text-light">
                                Commission directly to active public catalog
                            </label>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-cyber-primary">
                                <i class="fas fa-save me-1"></i> Commission Product
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Info Sidebar -->
        <div class="col-lg-4">
            <div class="card shadow-lg cyber-card mb-4">
                <div class="card-header cyber-card-header bg-dark">
                    <h5 class="mb-0 text-cyan"><i class="fas fa-info-circle me-2"></i> Catalog Guidelines</h5>
                </div>
                <div class="card-body">
                    <ul class="small text-muted ps-3 mb-0">
                        <li class="mb-2"><strong class="text-light">Accurate Specs:</strong> Clearly list bus width, memory size, thermal TDP, and form factor.</li>
                        <li class="mb-2"><strong class="text-light">Real Photography:</strong> Use real enthusiast component photos rather than generic icons.</li>
                        <li class="mb-2"><strong class="text-light">Stock Alerts:</strong> Items with &lt; 5 units will automatically trigger the Low Stock badge.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

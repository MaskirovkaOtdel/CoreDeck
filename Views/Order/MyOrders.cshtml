@model List<Order>

@{
    ViewData["Title"] = "Dispatch Log & Orders";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="text-cyan fw-bold mb-1"><i class="fas fa-boxes me-2"></i> Deployment Log</h2>
            <p class="text-muted small mb-0">Track historical equipment orders, dispatch status, and invoices</p>
        </div>
        <a href="@Url.Action("Index", "Product")" class="btn btn-outline-cyber btn-sm">
            <i class="fas fa-microchip me-1"></i> Order More Gear
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card shadow-lg cyber-card text-center py-5">
            <div class="card-body">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h4 class="text-light">No historical orders logged</h4>
                <p class="text-muted small mb-4">You have not initiated any hardware deployments yet.</p>
                <a href="@Url.Action("Index", "Product")" class="btn btn-cyber-primary">
                    <i class="fas fa-shopping-bag me-1"></i> Explore Hardware Arsenal
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var order in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card shadow-lg cyber-card h-100 d-flex flex-column">
                        <div class="card-header cyber-card-header bg-dark d-flex justify-content-between align-items-center">
                            <span class="text-light font-monospace fw-bold">#CD-@order.Id.ToString("D6")</span>
                            <span class="badge @GetStatusBadge(order.Status)">@order.Status</span>
                        </div>
                        <div class="card-body d-flex flex-column flex-grow-1">
                            <div class="mb-3">
                                <small class="text-muted d-block">Commissioned On</small>
                                <span class="text-light small font-monospace">@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted d-block">Destination Coordinates</small>
                                <span class="text-light small">
                                    @order.ShippingAddress, @order.City (@order.Country)
                                </span>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted d-block">Hardware Payload</small>
                                <span class="text-cyan small fw-bold">
                                    @order.OrderItems.Count component item(s) &bull; @order.OrderItems.Sum(i => i.Quantity) units
                                </span>
                            </div>

                            <div class="cyber-divider my-2"></div>

                            <div class="d-flex justify-content-between align-items-baseline mt-auto pt-2">
                                <div>
                                    <small class="text-muted d-block">Requisition Total</small>
                                    <span class="h5 text-cyan font-monospace fw-bold mb-0">€@order.TotalPrice.ToString("F2")</span>
                                </div>
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("Details", "Order", new { id = order.Id })" class="btn btn-cyber-primary">
                                        <i class="fas fa-eye me-1"></i> Details
                                    </a>
                                    <a href="@Url.Action("Invoice", "Order", new { id = order.Id })" class="btn btn-outline-secondary" title="Invoice">
                                        <i class="fas fa-file-invoice"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    private string GetStatusBadge(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "bg-warning text-dark",
            OrderStatus.Processing => "bg-info text-dark",
            OrderStatus.Shipped => "bg-primary text-white",
            OrderStatus.Delivered => "bg-success text-white",
            OrderStatus.Cancelled => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }
}

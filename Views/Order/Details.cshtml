@model Order

@{
    ViewData["Title"] = "Order #" + Model.Id;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("MyOrders", "Order")">My Orders</a></li>
        <li class="breadcrumb-item active">Order #@Model.Id</li>
    </ol>
</nav>

<div class="row mb-4">
    <div class="col-lg-8">
        <!-- Order Status -->
        <div class="card shadow mb-4">
            <div class="card-header" style="@($"background-color: {GetStatusColor(Model.Status)}; color: white;")">
                <h5 class="mb-0"><i class="fas fa-info-circle"></i> Order Status</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-3">
                        <i class="fas fa-check-circle fa-2x @(Model.Status != OrderStatus.Cancelled ? "text-success" : "text-muted")"></i>
                        <p class="small mt-2">Order Placed</p>
                        <small class="text-muted">@Model.OrderDate.ToString("MMM dd, yyyy")</small>
                    </div>
                    <div class="col-md-3">
                        <i class="fas fa-cog fa-2x @(Model.Status >= OrderStatus.Processing && Model.Status != OrderStatus.Cancelled ? "text-success" : "text-muted")"></i>
                        <p class="small mt-2">Processing</p>
                        <small class="text-muted">In progress</small>
                    </div>
                    <div class="col-md-3">
                        <i class="fas fa-truck fa-2x @(Model.Status >= OrderStatus.Shipped && Model.Status != OrderStatus.Cancelled ? "text-success" : "text-muted")"></i>
                        <p class="small mt-2">Shipped</p>
                        <small class="text-muted">@(Model.ShippedDate?.ToString("MMM dd, yyyy") ?? "Pending")</small>
                    </div>
                    <div class="col-md-3">
                        <i class="fas fa-box fa-2x @(Model.Status == OrderStatus.Delivered ? "text-success" : "text-muted")"></i>
                        <p class="small mt-2">Delivered</p>
                        <small class="text-muted">@(Model.DeliveredDate?.ToString("MMM dd, yyyy") ?? "Pending")</small>
                    </div>
                </div>

                <div class="alert alert-info mt-3 mb-0">
                    <strong>Current Status:</strong> @Model.Status
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="card shadow mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-list"></i> Order Items</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>
                                    <strong>@item.ProductSnapshot</strong><br />
                                    <small class="text-muted">Product ID: @item.ProductId</small>
                                </td>
                                <td>@item.Quantity</td>
                                <td>€@item.UnitPrice.ToString("F2")</td>
                                <td><strong>€@item.TotalPrice.ToString("F2")</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Order Summary Sidebar -->
    <div class="col-lg-4">
        <!-- Order Summary -->
        <div class="card shadow mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-receipt"></i> Order Summary</h5>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-6">Order Number:</div>
                    <div class="col-6 text-end"><strong>#@Model.Id</strong></div>
                </div>
                <div class="row mb-2">
                    <div class="col-6">Order Date:</div>
                    <div class="col-6 text-end">@Model.OrderDate.ToString("MMM dd, yyyy")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-6">Items:</div>
                    <div class="col-6 text-end">@Model.OrderItems.Sum(oi => oi.Quantity)</div>
                </div>

                <hr />

                <div class="row mb-3">
                    <div class="col-6">Subtotal:</div>
                    <div class="col-6 text-end">€@Model.TotalPrice.ToString("F2")</div>
                </div>

                <div class="row mb-3">
                    <div class="col-6"><strong>Total Amount:</strong></div>
                    <div class="col-6 text-end">
                        <h5 class="text-primary mb-0">€@Model.TotalPrice.ToString("F2")</h5>
                    </div>
                </div>
            </div>
        </div>

        <!-- Shipping Information -->
        <div class="card shadow mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-map-marker-alt"></i> Shipping Address</h5>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>@Model.ShippingAddress</strong></p>
                <p class="mb-1">@Model.PostalCode @Model.City</p>
                <p class="mb-0">@Model.Country</p>
            </div>
        </div>

        <!-- Actions -->
        @if (Model.Status == OrderStatus.Pending || Model.Status == OrderStatus.Processing)
        {
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-exclamation-circle"></i> Actions</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Order" asp-action="CancelOrder" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Are you sure you want to cancel this order?')">
                            <i class="fas fa-times"></i> Cancel Order
                        </button>
                    </form>
                </div>
            </div>
        }

        <!-- Download Invoice -->
        <div class="mt-3">
            <a href="#" class="btn btn-outline-primary w-100">
                <i class="fas fa-download"></i> Download Invoice
            </a>
        </div>
    </div>
</div>

<!-- Back Button -->
<div>
    <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Back to Orders
    </a>
</div>

@functions {
    private string GetStatusColor(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "#FFC107",
            OrderStatus.Processing => "#17A2B8",
            OrderStatus.Shipped => "#007BFF",
            OrderStatus.Delivered => "#28A745",
            OrderStatus.Cancelled => "#DC3545",
            _ => "#6C757D"
        };
    }
}

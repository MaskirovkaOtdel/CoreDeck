@model Order

@{
    ViewData["Title"] = "Order Details #" + Model.Id;
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show cyber-alert mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb cyber-breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("MyOrders", "Order")">Deployments</a></li>
            <li class="breadcrumb-item active text-cyan" aria-current="page">Order #CD-@Model.Id.ToString("D6")</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="text-cyan fw-bold mb-1">
                <i class="fas fa-box-open me-2"></i> Deployment Status: #CD-@Model.Id.ToString("D6")
            </h2>
            <small class="text-muted font-monospace">Placed on @Model.OrderDate.ToString("yyyy-MM-dd HH:mm:ss") UTC</small>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Invoice", "Order", new { id = Model.Id })" class="btn btn-cyber-primary">
                <i class="fas fa-file-invoice me-2"></i> Printable Tax Invoice
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <!-- Order Progress Pipeline -->
            <div class="card shadow-lg cyber-card mb-4">
                <div class="card-header cyber-card-header bg-dark d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-light"><i class="fas fa-stream me-2"></i> Dispatch Pipeline</h5>
                    <span class="badge @GetStatusBadge(Model.Status) fs-6">@Model.Status</span>
                </div>
                <div class="card-body p-4">
                    <div class="row text-center g-3">
                        <div class="col-3">
                            <i class="fas fa-check-circle fa-2x @(Model.Status != OrderStatus.Cancelled ? "text-success" : "text-muted")"></i>
                            <div class="small mt-2 text-light fw-bold">Placed</div>
                            <small class="text-muted">@Model.OrderDate.ToString("MMM dd")</small>
                        </div>
                        <div class="col-3">
                            <i class="fas fa-microchip fa-2x @(Model.Status >= OrderStatus.Processing && Model.Status != OrderStatus.Cancelled ? "text-cyan" : "text-muted")"></i>
                            <div class="small mt-2 text-light fw-bold">Assembly</div>
                            <small class="text-muted">In Progress</small>
                        </div>
                        <div class="col-3">
                            <i class="fas fa-truck-fast fa-2x @(Model.Status >= OrderStatus.Shipped && Model.Status != OrderStatus.Cancelled ? "text-info" : "text-muted")"></i>
                            <div class="small mt-2 text-light fw-bold">Dispatched</div>
                            <small class="text-muted">@(Model.ShippedDate?.ToString("MMM dd") ?? "Pending")</small>
                        </div>
                        <div class="col-3">
                            <i class="fas fa-box fa-2x @(Model.Status == OrderStatus.Delivered ? "text-success" : "text-muted")"></i>
                            <div class="small mt-2 text-light fw-bold">Delivered</div>
                            <small class="text-muted">@(Model.DeliveredDate?.ToString("MMM dd") ?? "Pending")</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items -->
            <div class="card shadow-lg cyber-card mb-4">
                <div class="card-header cyber-card-header bg-dark">
                    <h5 class="mb-0 text-cyan"><i class="fas fa-boxes me-2"></i> Hardware Requisition Items</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover cyber-table mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Component</th>
                                <th>Units</th>
                                <th>Unit Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-light">@item.ProductSnapshot</div>
                                        <small class="text-muted font-monospace">SKU: CD-@item.ProductId.ToString("D6")</small>
                                    </td>
                                    <td class="font-monospace text-light">@item.Quantity</td>
                                    <td class="font-monospace text-muted">€@item.UnitPrice.ToString("F2")</td>
                                    <td class="font-monospace text-cyan fw-bold">€@item.TotalPrice.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Order Financial Summary -->
            <div class="card shadow-lg cyber-card mb-4">
                <div class="card-header cyber-card-header bg-dark">
                    <h5 class="mb-0 text-cyan"><i class="fas fa-receipt me-2"></i> Financial Summary</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Order ID:</span>
                        <span class="text-light font-monospace">#CD-@Model.Id.ToString("D6")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Hardware Items:</span>
                        <span class="text-light font-monospace">@Model.OrderItems.Sum(oi => oi.Quantity) units</span>
                    </div>
                    <div class="cyber-divider my-3"></div>
                    <div class="d-flex justify-content-between align-items-baseline mb-3">
                        <span class="h6 text-light fw-bold mb-0">Total Requisition:</span>
                        <span class="h4 text-cyan font-monospace fw-bold mb-0">€@Model.TotalPrice.ToString("F2")</span>
                    </div>

                    <a href="@Url.Action("Invoice", "Order", new { id = Model.Id })" class="btn btn-outline-cyber btn-sm w-100">
                        <i class="fas fa-file-invoice me-1"></i> View Tax Invoice
                    </a>
                </div>
            </div>

            <!-- Destination Coordinates -->
            <div class="card shadow-lg cyber-card mb-4">
                <div class="card-header cyber-card-header bg-dark">
                    <h5 class="mb-0 text-light"><i class="fas fa-map-marker-alt me-2 text-cyan"></i> Destination Coordinates</h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-light fw-bold mb-1">@Model.ShippingAddress</p>
                    <p class="text-muted small mb-1">@Model.PostalCode @Model.City</p>
                    <p class="text-muted small mb-0">@Model.Country</p>
                </div>
            </div>

            <!-- Actions -->
            @if (Model.Status == OrderStatus.Pending || Model.Status == OrderStatus.Processing)
            {
                <div class="card shadow-lg cyber-card border-danger">
                    <div class="card-header cyber-card-header bg-danger text-white">
                        <h6 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i> Cancellation Protocol</h6>
                    </div>
                    <div class="card-body p-3">
                        <p class="text-muted small mb-3">Assembly has not yet dispatched. You may cancel and de-allocate hardware stock.</p>
                        <form asp-controller="Order" asp-action="CancelOrder" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100" 
                                    onclick="return confirm('Are you sure you want to cancel this order?')">
                                <i class="fas fa-times me-1"></i> Cancel Hardware Order
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <div>
        <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to Deployments
        </a>
    </div>
</div>

@functions {
    private string GetStatusBadge(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "bg-warning text-dark",
            OrderStatus.Processing => "bg-info text-dark",
            OrderStatus.Shipped => "bg-primary text-white",
            OrderStatus.Delivered => "bg-success text-white",
            OrderStatus.Cancelled => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }
}

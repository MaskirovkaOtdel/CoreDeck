@model List<Product>

@{
    ViewData["Title"] = "Cyber-Grade PC Hardware & Gaming Gear";
    var categoriesCount = (int?)ViewData["CategoriesCount"] ?? 0;
    var productsCount = (int?)ViewData["ProductsCount"] ?? 0;
}

<!-- Cyber Hero Section -->
<div class="cyber-hero mb-5 p-4 p-md-5 rounded position-relative overflow-hidden">
    <div class="row align-items-center position-relative" style="z-index: 2;">
        <div class="col-lg-8">
            <span class="badge bg-dark border border-cyan text-cyan py-2 px-3 mb-3 font-monospace">
                <i class="fas fa-terminal me-2"></i> SYSTEM PROTOCOL v0.1.0 // ALPHA
            </span>
            <h1 class="display-4 fw-extrabold text-light mb-3">
                UNLEASH ULTIMATE <span class="text-cyan text-glow">HARDWARE</span> PERFORMANCE
            </h1>
            <p class="lead text-muted mb-4 fs-5 lh-base">
                Curated enthusiast PC battlestations, flagship RTX & RDNA graphics cards, multicore processors, and lightning-fast Gen4/Gen5 PCIe solid state drives.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a href="@Url.Action("Index", "Product")" class="btn btn-cyber-primary btn-lg px-4 py-3 fw-bold">
                    <i class="fas fa-microchip me-2"></i> Browse Hardware Arsenal
                </a>
                <a href="#featured" class="btn btn-outline-cyber btn-lg px-4 py-3">
                    <i class="fas fa-bolt me-2 text-warning"></i> Featured Silicon
                </a>
            </div>
        </div>
        <div class="col-lg-4 d-none d-lg-block text-center">
            <div class="cyber-orb">
                <i class="fas fa-network-wired fa-8x text-cyan animate-pulse opacity-75"></i>
            </div>
        </div>
    </div>
</div>

<!-- Key Performance Stats -->
<div class="row g-3 mb-5">
    <div class="col-md-4">
        <div class="card shadow cyber-card text-center h-100 p-3">
            <div class="card-body">
                <i class="fas fa-microchip fa-3x text-cyan mb-3"></i>
                <h3 class="fw-bold text-light font-monospace">@productsCount</h3>
                <h6 class="text-muted text-uppercase small">Hardware Units Deployed</h6>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow cyber-card text-center h-100 p-3">
            <div class="card-body">
                <i class="fas fa-layer-group fa-3x text-warning mb-3"></i>
                <h3 class="fw-bold text-light font-monospace">@categoriesCount</h3>
                <h6 class="text-muted text-uppercase small">Specialized Hardware Categories</h6>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow cyber-card text-center h-100 p-3">
            <div class="card-body">
                <i class="fas fa-shield-halved fa-3x text-success mb-3"></i>
                <h3 class="fw-bold text-light font-monospace">100%</h3>
                <h6 class="text-muted text-uppercase small">Verified Authenticity & Warranty</h6>
            </div>
        </div>
    </div>
</div>

<!-- Featured Hardware Section -->
@if (Model != null && Model.Count > 0)
{
    <div id="featured" class="mb-5 pt-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="text-cyan fw-bold mb-1"><i class="fas fa-star text-warning me-2"></i> Featured Hardware</h2>
                <p class="text-muted small mb-0">High-demand components and pre-built battlestations</p>
            </div>
            <a href="@Url.Action("Index", "Product")" class="btn btn-outline-cyber btn-sm">
                View All (@productsCount) <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <partial name="_ProductCard" model="product" />
                </div>
            }
        </div>
    </div>
}

<!-- CoreDeck Pillars -->
<div class="card shadow-lg cyber-card mb-5">
    <div class="card-header cyber-card-header bg-dark">
        <h5 class="mb-0 text-cyan"><i class="fas fa-terminal me-2"></i> The CoreDeck Standard</h5>
    </div>
    <div class="card-body p-4 p-md-5">
        <div class="row g-4 text-center text-md-start">
            <div class="col-md-3">
                <i class="fas fa-truck-fast fa-2x text-cyan mb-3"></i>
                <h6 class="text-light fw-bold">Rapid Dispatch</h6>
                <p class="text-muted small mb-0">Insured expedited delivery with anti-static packaging guaranteed.</p>
            </div>
            <div class="col-md-3">
                <i class="fas fa-shield-virus fa-2x text-success mb-3"></i>
                <h6 class="text-light fw-bold">Silicon Lottery QC</h6>
                <p class="text-muted small mb-0">Every batch is benchmarked and verified against thermal benchmarks.</p>
            </div>
            <div class="col-md-3">
                <i class="fas fa-headset fa-2x text-warning mb-3"></i>
                <h6 class="text-light fw-bold">Overclocker Support</h6>
                <p class="text-muted small mb-0">Direct access to PC build engineers for custom configuration advice.</p>
            </div>
            <div class="col-md-3">
                <i class="fas fa-rotate-left fa-2x text-danger mb-3"></i>
                <h6 class="text-light fw-bold">30-Day Hassle-Free RMA</h6>
                <p class="text-muted small mb-0">Zero restocking fee on defective or non-compatible components.</p>
            </div>
        </div>
    </div>
</div>

<!-- Newsletter / Broadcast Section -->
<div class="card shadow-lg cyber-card p-4 p-md-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h3 class="text-cyan fw-bold mb-2"><i class="fas fa-satellite-dish me-2"></i> Hardware Drop Notifications</h3>
            <p class="text-muted small mb-4">Subscribe to receive alerts the instant new GPUs, processors, or limited edition cases arrive in stock.</p>
            <form class="row g-2 justify-content-center" onsubmit="event.preventDefault(); alert('Subscribed to CoreDeck hardware drops.');">
                <div class="col-sm-7">
                    <input type="email" class="form-control cyber-input font-monospace" placeholder="operator@coredeck.local" required />
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-cyber-primary w-100 fw-bold">
                        <i class="fas fa-bell me-1"></i> Subscribe Alerts
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

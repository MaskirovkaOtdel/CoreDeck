@model List<Product>

@{
    ViewData["Title"] = "Home - CoreDeck E-Shop";
    var categoriesCount = (int?)ViewData["CategoriesCount"] ?? 0;
    var productsCount = (int?)ViewData["ProductsCount"] ?? 0;
}

<!-- Hero Section -->
<div class="hero-section mb-5">
    <h1 class="mb-3"><i class="fas fa-microchip"></i> Welcome to CoreDeck</h1>
    <p>Your Premier Destination for Premium Tech Products</p>
    <div class="mt-4">
        <a href="@Url.Action("Index", "Product")" class="btn btn-light btn-lg me-2">
            <i class="fas fa-shopping-bag"></i> Shop Now
        </a>
        <a href="#featured" class="btn btn-outline-light btn-lg">
            <i class="fas fa-star"></i> Featured Products
        </a>
    </div>
</div>

<!-- Stats Section -->
<div class="row mb-5">
    <div class="col-md-4 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="fas fa-cube fa-3x text-primary mb-3"></i>
                <h5 class="card-title">@productsCount Products</h5>
                <p class="card-text text-muted">Browse our extensive catalog</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="fas fa-list fa-3x text-success mb-3"></i>
                <h5 class="card-title">@categoriesCount Categories</h5>
                <p class="card-text text-muted">Organized by product type</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="fas fa-shield-alt fa-3x text-info mb-3"></i>
                <h5 class="card-title">Secure Checkout</h5>
                <p class="card-text text-muted">100% safe transactions</p>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="mb-5">
    <h2 class="text-center mb-4">Why Choose CoreDeck?</h2>
    <div class="row">
        <div class="col-md-3 mb-3">
            <div class="card text-center border-0">
                <div class="card-body">
                    <i class="fas fa-bolt fa-2x text-warning mb-3"></i>
                    <h5>Fast Shipping</h5>
                    <p class="text-muted small">Quick and reliable delivery</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center border-0">
                <div class="card-body">
                    <i class="fas fa-redo fa-2x text-info mb-3"></i>
                    <h5>Easy Returns</h5>
                    <p class="text-muted small">30-day return policy</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center border-0">
                <div class="card-body">
                    <i class="fas fa-headset fa-2x text-success mb-3"></i>
                    <h5>24/7 Support</h5>
                    <p class="text-muted small">Expert customer service</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center border-0">
                <div class="card-body">
                    <i class="fas fa-tag fa-2x text-danger mb-3"></i>
                    <h5>Best Prices</h5>
                    <p class="text-muted small">Competitive rates guaranteed</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Featured Products Section -->
@if (Model != null && Model.Count > 0)
{
    <div id="featured" class="mb-5 pt-5">
        <h2 class="text-center mb-4"><i class="fas fa-star"></i> Featured Products</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    @await Html.PartialAsync("_ProductCard", product)
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a href="@Url.Action("Index", "Product")" class="btn btn-primary btn-lg">
                <i class="fas fa-arrow-right"></i> View All Products
            </a>
        </div>
    </div>
}

<!-- CTA Section -->
<div class="bg-primary text-white rounded-lg p-5 text-center mb-5">
    <h3 class="mb-3">Ready to Upgrade Your Tech?</h3>
    <p class="mb-4">Explore our latest collection and find the perfect products for you.</p>
    <a href="@Url.Action("Index", "Product")" class="btn btn-light btn-lg">
        <i class="fas fa-shopping-bag"></i> Start Shopping
    </a>
</div>

<!-- Newsletter Section -->
<div class="mb-5">
    <div class="card bg-light">
        <div class="card-body text-center p-5">
            <h4 class="mb-3">Subscribe to Our Newsletter</h4>
            <p class="text-muted mb-4">Get exclusive deals and updates on new products</p>
            <form class="row g-2 justify-content-center">
                <div class="col-md-5">
                    <input type="email" class="form-control" placeholder="Enter your email" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Subscribe</button>
                </div>
            </form>
        </div>
    </div>
</div>

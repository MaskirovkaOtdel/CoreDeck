@inject Final_Efstathiadis_Theodors.Data.ApplicationDbContext DbContext

@{
    var navCategories = DbContext.Categories.OrderBy(c => c.Id).ToList();
    var currentYear = DateTime.UtcNow.Year;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | CoreDeck - Cyber-Grade PC Hardware & Gaming Gear</title>

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & FontAwesome 6 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Cyberpunk Theme Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="cyber-body d-flex flex-column min-vh-100">
    <header>
        <!-- Main Navigation -->
        <nav class="navbar navbar-expand-lg navbar-dark cyber-navbar sticky-top">
            <div class="container-fluid px-lg-4">
                <!-- Brand -->
                <a class="navbar-brand cyber-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="cyber-logo-box me-2"><i class="fas fa-microchip"></i></span>
                    <span class="brand-text">CORE<span class="text-cyan">DECK</span></span>
                    <span class="badge bg-cyber-neon text-dark ms-2 small d-none d-sm-inline-block font-monospace">ALPHA v0.1.0</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler cyber-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Items -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i> Home
                            </a>
                        </li>

                        <!-- Dynamic Hardware Categories Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="productsDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-microchip me-1"></i> Hardware Arsenal
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark cyber-dropdown" aria-labelledby="productsDropdown">
                                <li>
                                    <a class="dropdown-item fw-bold text-cyan" asp-controller="Product" asp-action="Index">
                                        <i class="fas fa-layer-group me-2"></i> All Hardware Items
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-secondary"></li>
                                @foreach (var cat in navCategories)
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.Id">
                                            <i class="@(string.IsNullOrEmpty(cat.IconUrl) ? "fas fa-tag" : cat.IconUrl) me-2 text-cyan"></i> @cat.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    </ul>

                    <!-- Search Form -->
                    <form class="d-flex me-lg-3 mb-2 mb-lg-0" asp-controller="Product" asp-action="Index" method="get">
                        <div class="input-group input-group-sm cyber-nav-search">
                            <input class="form-control cyber-input" type="search" placeholder="Search RTX, OLED, DDR5..." name="search" />
                            <button class="btn btn-cyber-primary" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- User and Cart Actions -->
                    <ul class="navbar-nav mb-2 mb-lg-0 align-items-lg-center">
                        <!-- Dynamic Cart Badge ViewComponent -->
                        <li class="nav-item me-lg-2">
                            <a class="nav-link d-flex align-items-center cyber-cart-link" asp-controller="Cart" asp-action="Index">
                                <i class="fas fa-shopping-cart me-1"></i> Cart
                                @await Component.InvokeAsync("CartBadge")
                            </a>
                        </li>

                        <!-- User Profile / Admin Menu -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle fa-lg me-1 text-cyan"></i>
                                <span>@(User.Identity?.IsAuthenticated == true ? User.Identity.Name?.Split('@')[0] : "Account")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end cyber-dropdown" aria-labelledby="userDropdown">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li class="dropdown-header text-muted font-monospace small">OPERATOR TERMINAL</li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="fas fa-id-badge me-2 text-cyan"></i> Operator Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">
                                            <i class="fas fa-box-open me-2 text-cyan"></i> Deployment Orders
                                        </a>
                                    </li>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider border-secondary"></li>
                                        <li class="dropdown-header text-warning font-monospace small">ROOT ADMINISTRATION</li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="AdminProduct" asp-action="Index">
                                                <i class="fas fa-microchip me-2 text-warning"></i> Inventory Control
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="AdminOrder" asp-action="Index">
                                                <i class="fas fa-clipboard-list me-2 text-warning"></i> Orders Dispatch
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-sign-out-alt me-2"></i> Disconnect (Logout)
                                            </button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                                            <i class="fas fa-sign-in-alt me-2 text-cyan"></i> Sign In
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Register">
                                            <i class="fas fa-user-plus me-2 text-cyan"></i> Initialize Account
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Cyberpunk Footer -->
    <footer class="cyber-footer mt-5 pt-5 pb-3">
        <div class="container-fluid px-lg-4">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="text-cyan fw-bold mb-3 d-flex align-items-center">
                        <i class="fas fa-microchip me-2"></i> COREDECK
                    </h5>
                    <p class="text-muted small lh-base">
                        The ultimate enthusiast hardware platform. Built for competitive overclockers, PC builders, and esports competitors demanding uncompromising silicon performance.
                    </p>
                    <div class="d-flex gap-3 text-cyan">
                        <span class="badge bg-dark border border-secondary text-cyan font-monospace">Alpha v0.1.0</span>
                        <span class="badge bg-dark border border-secondary text-light font-monospace">Enthusiast Grade</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-light fw-bold text-uppercase small mb-3">Hardware Arsenal</h6>
                    <ul class="list-unstyled cyber-footer-links small">
                        <li><a href="@Url.Action("Index", "Product")">All Products</a></li>
                        @foreach (var cat in navCategories.Take(4))
                        {
                            <li><a href="@Url.Action("Index", "Product", new { categoryId = cat.Id })">@cat.Name</a></li>
                        }
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-light fw-bold text-uppercase small mb-3">Platform Links</h6>
                    <ul class="list-unstyled cyber-footer-links small">
                        <li><a href="@Url.Action("Index", "Home")">Home Terminal</a></li>
                        <li><a href="@Url.Action("MyOrders", "Order")">Deployment Tracking</a></li>
                        <li><a href="@Url.Action("Privacy", "Home")">Security & Privacy</a></li>
                        <li><a href="@Url.Action("Profile", "Account")">Operator Profile</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="text-light fw-bold text-uppercase small mb-3">Platform Comms</h6>
                    <p class="text-muted small mb-2">
                        <i class="fas fa-envelope text-cyan me-2"></i> support@coredeck.local
                    </p>
                    <p class="text-muted small mb-2">
                        <i class="fas fa-shield-halved text-cyan me-2"></i> 256-bit Encrypted Checkouts
                    </p>
                    <p class="text-muted small mb-0">
                        <i class="fas fa-location-dot text-cyan me-2"></i> Athens, Greece &bull; Worldwide Fast Shipping
                    </p>
                </div>
            </div>

            <hr class="border-secondary my-3" />

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center text-muted small">
                <p class="mb-0">&copy; @currentYear CoreDeck Systems. All rights reserved.</p>
                <p class="mb-0 font-monospace">ENGINEERED FOR EXTREME PERFORMANCE</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechHub E-Shop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Main Navigation -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
            <div class="container-lg">
                <!-- Brand -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-microchip"></i> CoreDeck
                </a>

                <!-- Toggle Button -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Items -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> Home
                            </a>
                        </li>

                        <!-- Products Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="productsDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-cube"></i> Products
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="productsDropdown">
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index">All Products</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="1">PCs & Desktops</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="2">Laptops</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="3">Gaming Consoles</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="4">Handhelds</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="5">Monitors & Peripherals</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="6">Components</a></li>
                            </ul>
                        </li>

                        <!-- Search Form -->
                        <li class="nav-item">
                            <form class="d-flex" asp-controller="Product" asp-action="Search" method="get">
                                <div class="input-group input-group-sm">
                                    <input class="form-control" type="search" placeholder="Search products..." name="searchTerm" />
                                    <button class="btn btn-primary" type="submit">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </form>
                        </li>

                        <!-- Cart -->
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
                                <i class="fas fa-shopping-cart"></i> Cart
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    0
                                </span>
                            </a>
                        </li>

                        <!-- User Menu -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle"></i> Account
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end" aria-labelledby="userDropdown">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Order" asp-action="MyOrders">My Orders</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="AdminProduct" asp-action="Index">Admin Panel</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="dropdown-item">
                                                <i class="fas fa-sign-out-alt"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Register</a></li>
                                }
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="min-vh-100">
        <div class="container-lg py-4">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-5 pt-5 pb-3">
        <div class="container-lg">
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <h5><i class="fas fa-microchip"></i> TechHub</h5>
                    <p class="text-muted">Your premier destination for the latest tech products and gadgets.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled">
                        <li><a class="text-muted text-decoration-none" href="@Url.Action("Index", "Product")">Shop All Products</a></li>
                        <li><a class="text-muted text-decoration-none" href="@Url.Action("Index", "Home")">About Us</a></li>
                        <li><a class="text-muted text-decoration-none" href="#">Contact Us</a></li>
                        <li><a class="text-muted text-decoration-none" href="#">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Contact</h6>
                    <p class="text-muted">
                        <i class="fas fa-envelope"></i> support@techhub.com<br>
                        <i class="fas fa-phone"></i> +1 (555) 123-4567<br>
                        <i class="fas fa-map-marker-alt"></i> Athens, Greece
                    </p>
                </div>
            </div>
            <hr class="bg-secondary" />
            <div class="text-center text-muted">
                <p class="mb-0">&copy; 2024 TechHub E-Shop. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

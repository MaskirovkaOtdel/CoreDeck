@model Product

<div class="card h-100 shadow-lg cyber-card cyber-product-card d-flex flex-column">
    <!-- Product Image -->
    <div class="position-relative overflow-hidden cyber-card-media" style="height: 220px; background: #070a10;">
        <img src="@Model.ImageUrl" 
             class="card-img-top img-fluid cyber-card-img" 
             alt="@Model.Name"
             style="height: 100%; width: 100%; object-fit: cover;" />

        <div class="position-absolute top-0 start-0 m-2">
            <span class="badge bg-dark bg-opacity-75 text-cyan border border-secondary font-monospace small">
                CD-@Model.Id.ToString("D6")
            </span>
        </div>

        @if (Model.Stock <= 5 && Model.Stock > 0)
        {
            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2 fw-bold">
                <i class="fas fa-exclamation-triangle"></i> Low Stock (@Model.Stock)
            </span>
        }
        else if (Model.Stock == 0)
        {
            <span class="badge bg-danger position-absolute top-0 end-0 m-2 fw-bold">
                <i class="fas fa-ban"></i> Out of Stock
            </span>
        }
        else
        {
            <span class="badge bg-success bg-opacity-75 position-absolute top-0 end-0 m-2">
                In Stock
            </span>
        }
    </div>

    <!-- Product Info -->
    <div class="card-body p-3 d-flex flex-column flex-grow-1">
        <div class="mb-2">
            <span class="badge bg-secondary bg-opacity-50 text-light small">@Model.Category?.Name</span>
        </div>

        <a href="@Url.Action("Details", "Product", new { id = Model.Id })" 
           class="text-decoration-none text-light">
            <h6 class="card-title fw-bold mb-2 text-truncate-2" title="@Model.Name">@Model.Name</h6>
        </a>

        <p class="card-text text-muted small flex-grow-1 text-truncate-2">
            @Model.Description
        </p>

        <div class="d-flex justify-content-between align-items-baseline mt-3 pt-2 border-top border-secondary">
            <div>
                <span class="h5 text-cyan font-monospace fw-bold mb-0">
                    €@Model.Price.ToString("F2")
                </span>
            </div>
            <small class="text-muted font-monospace">@Model.Stock units</small>
        </div>
    </div>

    <!-- Card Footer with Actions -->
    <div class="card-footer bg-dark border-top border-secondary p-3 d-grid gap-2">
        <div class="d-flex gap-2">
            <a href="@Url.Action("Details", "Product", new { id = Model.Id })" 
               class="btn btn-outline-secondary btn-sm flex-grow-1">
                <i class="fas fa-eye me-1"></i> Specs
            </a>
            @if (Model.Stock > 0)
            {
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-grow-1">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn btn-cyber-primary btn-sm w-100">
                        <i class="fas fa-cart-plus me-1"></i> Add
                    </button>
                </form>
            }
            else
            {
                <button class="btn btn-secondary btn-sm flex-grow-1" disabled>
                    <i class="fas fa-times me-1"></i> Depleted
                </button>
            }
        </div>
    </div>
</div>

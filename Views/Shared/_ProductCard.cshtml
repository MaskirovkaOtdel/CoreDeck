@model Product

<div class="card h-100 shadow-sm hover-shadow transition-all">
    <!-- Product Image -->
    <div class="position-relative overflow-hidden" style="height: 200px;">
        <img src="@Model.ImageUrl" 
             class="card-img-top img-fluid" 
             alt="@Model.Name"
             style="height: 100%; object-fit: cover;" />
        @if (Model.Stock <= 5 && Model.Stock > 0)
        {
            <span class="badge bg-warning position-absolute top-0 end-0 m-2">Low Stock</span>
        }
        @if (Model.Stock == 0)
        {
            <span class="badge bg-danger position-absolute top-0 end-0 m-2">Out of Stock</span>
        }
    </div>

    <!-- Product Info -->
    <div class="card-body d-flex flex-column">
        <a href="@Url.Action("Details", "Product", new { id = Model.Id })" 
           class="text-decoration-none text-dark">
            <h5 class="card-title">@Model.Name</h5>
        </a>

        <p class="card-text text-muted small flex-grow-1">
            @Model.Description
        </p>

        <div class="mb-3">
            <span class="badge bg-secondary">@Model.Category?.Name</span>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <h4 class="text-primary mb-0">
                €@Model.Price.ToString("F2")
            </h4>
            <small class="text-muted">Stock: @Model.Stock</small>
        </div>
    </div>

    <!-- Card Footer with Actions -->
    <div class="card-footer bg-light border-top-0 d-grid gap-2">
        <a href="@Url.Action("Details", "Product", new { id = Model.Id })" 
           class="btn btn-outline-primary btn-sm">
            <i class="fas fa-eye"></i> View Details
        </a>
        @if (Model.Stock > 0)
        {
            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="quantity" value="1" />
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="fas fa-shopping-cart"></i> Add to Cart
                </button>
            </form>
        }
        else
        {
            <button class="btn btn-secondary btn-sm w-100" disabled>
                <i class="fas fa-times"></i> Out of Stock
            </button>
        }
    </div>
</div>
